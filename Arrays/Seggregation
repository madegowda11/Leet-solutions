				hm.put(arr[i], (hm.get(arr[i])+1));
			}else {
				hm.put(arr[i], 1);
			}
		}
		List<Integer> dup=new ArrayList();
		for(Entry<Integer,Integer> entry:hm.entrySet()) {
			if(entry.getValue()>=1) {
